rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedInVerified() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return request.auth != null && 'admin' in request.auth.token && request.auth.token.admin == true; }
    function merchant() { return get(/databases/$(db)/documents/merchantApplications/$(request.auth.uid)).data; }
    function isApprovedMerchant() {
      return signedInVerified()
        && exists(/databases/$(db)/documents/merchantApplications/$(request.auth.uid))
        && merchant().ownerId == request.auth.uid && merchant().status == 'approved';
    }
    function validShop(shop) {
      return shop.keys().hasOnly(['name','area','address','whatsapp'])
        && shop.name is string && shop.name.size() > 0 && shop.name.size() <= 80
        && shop.area is string && shop.area.size() > 0 && shop.area.size() <= 80
        && shop.address is string && shop.address.size() > 0 && shop.address.size() <= 160
        && shop.whatsapp is string && shop.whatsapp.matches('^9639[0-9]{8}$');
    }
    function validDocument(record) {
      return record.keys().hasOnly(['bytes','fileName','contentType','size','createdAt'])
        && record.bytes is bytes && record.bytes.size() > 0 && record.bytes.size() <= 700 * 1024
        && record.size is int && record.size == record.bytes.size()
        && record.contentType in ['image/jpeg','image/png','image/webp']
        && ((record.contentType == 'image/jpeg' && record.fileName == 'commercial-record.jpg')
          || (record.contentType == 'image/png' && record.fileName == 'commercial-record.png')
          || (record.contentType == 'image/webp' && record.fileName == 'commercial-record.webp'))
        && record.createdAt == request.time;
    }

    match /merchantApplications/{uid} {
      allow get: if isAdmin() || (signedInVerified() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedInVerified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ownerId','shop','status','submittedAt'])
        && request.resource.data.ownerId == uid && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time && validShop(request.resource.data.shop)
        && validDocument(getAfter(/databases/$(db)/documents/merchantDocuments/$(uid)).data);
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['ownerId','shop','status','submittedAt','reviewedAt','reviewerId','rejectionReason'])
        && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.shop == resource.data.shop
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.reviewerId == request.auth.uid && request.resource.data.reviewedAt == request.time
        && ((request.resource.data.status == 'approved' && !('rejectionReason' in request.resource.data))
          || (request.resource.data.status == 'rejected' && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0 && request.resource.data.rejectionReason.size() <= 500));
      allow delete: if false;
    }

    match /merchantDocuments/{uid} {
      allow get: if isAdmin() || (signedInVerified() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if signedInVerified() && request.auth.uid == uid
        && validDocument(request.resource.data)
        && getAfter(/databases/$(db)/documents/merchantApplications/$(uid)).data.ownerId == uid
        && getAfter(/databases/$(db)/documents/merchantApplications/$(uid)).data.status == 'pending'
        && getAfter(/databases/$(db)/documents/merchantApplications/$(uid)).data.submittedAt == request.time;
      allow update, delete: if false;
    }

    match /liveOffers/{id} {
      allow read: if true;
      allow create, update: if isApprovedMerchant() && id.matches('^9639[0-9]{8}_.+')
        && request.resource.data.keys().hasOnly(['shop','product','condition','price','currency','notes','updatedAt'])
        && request.resource.data.shop.keys().hasOnly(['name','area','address','whatsapp'])
        && request.resource.data.product.keys().hasOnly(['brand','name','storage','network'])
        && request.resource.data.shop.whatsapp == id.split('_')[0] && request.resource.data.shop == merchant().shop
        && request.resource.data.shop.name is string && request.resource.data.shop.name.size() > 0 && request.resource.data.shop.name.size() <= 80
        && request.resource.data.shop.area is string && request.resource.data.shop.area.size() <= 80
        && request.resource.data.shop.address is string && request.resource.data.shop.address.size() <= 160
        && request.resource.data.product.brand is string && request.resource.data.product.brand.size() <= 40
        && request.resource.data.product.name is string && request.resource.data.product.name.size() > 0 && request.resource.data.product.name.size() <= 60
        && request.resource.data.product.storage is string && request.resource.data.product.storage.size() <= 20
        && (!('network' in request.resource.data.product) || request.resource.data.product.network in ['4G','5G'])
        && request.resource.data.condition in ['new','used'] && request.resource.data.currency in ['USD','SYP']
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price < 1000000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /submissions/{id} {
      allow create: if isApprovedMerchant()
        && request.resource.data.keys().hasOnly(['shop','offers','notes','status','createdAt','clientId'])
        && request.resource.data.shop == merchant().shop
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.shop.name is string && request.resource.data.shop.name.size() <= 80
        && request.resource.data.offers is list && request.resource.data.offers.size() >= 1 && request.resource.data.offers.size() <= 10;
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
