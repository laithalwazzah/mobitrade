{
  "name": "my-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/core.test.ts tests/sprint01.test.ts tests/sprint03.test.ts tests/sprint04.test.ts tests/sprint06.test.ts tests/sprint07.test.ts",
    "test:e2e": "playwright test",
    "test:firestore": "node --import tsx --test tests/firestore-rest.test.ts",
    "test:rules": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-firestore-emulator.ps1",
    "test:rules:unit": "node --import tsx --test tests/firestore-emulator.test.ts",
    "qa:sprint04": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-sprint04-qa.ps1",
    "qa:sprint04:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/run-sprint04-auto-qa.ps1",
    "qa:sprint04:reset": "node --import tsx tests/qa/sprint04-seed.ts reset",
    "qa:sprint04:reseed": "node --import tsx tests/qa/sprint04-seed.ts",
    "backend:lint": "npm --prefix backend run lint",
    "backend:test": "npm --prefix backend test",
    "backend:build": "npm --prefix backend run build",
    "backend:test:emulator": "npm --prefix backend run test:emulator",
    "qa:sprint05": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/run-local.ps1",
    "qa:sprint06": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/run-sprint06.ps1",
    "qa:sprint06:verify-atomicity": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/verify-sprint06-atomicity.ps1",
    "test:sprint06:integrated": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:SPRINT06_AUTOMATED='1'; & backend/scripts/run-sprint06.ps1\"",
    "qa:sprint07": "powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/run-sprint07.ps1",
    "test:sprint07:integrated": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:SPRINT07_AUTOMATED='1'; & backend/scripts/run-sprint07.ps1\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
